{
  "name": "nova-desktop",
  "version": "1.0.0",
  "description": "NOVA — AI Assistant powered by NVIDIA",
  "main": "main.js",
  "homepage": "http://129.159.239.56",
  "author": {
    "name": "NOVA",
    "email": "nova@assistant.ai"
  },
  "private": true,
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder build --linux --win",
    "build:linux": "electron-builder build --linux",
    "build:win": "electron-builder build --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^7.0.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nova.assistant",
    "productName": "NOVA",
    "copyright": "Copyright © 2026 NOVA",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "NOVA <nova@assistant.ai>",
      "desktop": {
        "Name": "NOVA",
        "Comment": "NOVA — AI Assistant powered by NVIDIA",
        "Keywords": "AI;Assistant;NVIDIA;Chat;"
      },
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu",
        "--in-process-gpu",
        "--disable-dev-shm-usage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png"
    }
  }
}
