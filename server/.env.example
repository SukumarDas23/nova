# NVIDIA API Key — get from https://integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA Model — confirmed 753B MoE model
# Check available models at: https://integrate.api.nvidia.com/v1/models
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3_3-nemotron-super-49b-v1

# Server port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
